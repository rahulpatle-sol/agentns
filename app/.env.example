# Public values only. Never put a private key or secret in a VITE_ variable —
# anything prefixed with VITE_ is inlined into the shipped JavaScript bundle.

# Which cluster the UI targets: localnet | devnet | mainnet-beta
VITE_SOLANA_CLUSTER=localnet

# RPC endpoint for the selected cluster.
VITE_SOLANA_RPC_URL=http://127.0.0.1:8899

# WebSocket endpoint. Defaults to the RPC URL with http -> ws when omitted.
# VITE_SOLANA_WS_URL=ws://127.0.0.1:8900

# AgentNS program id. Matches `declare_id!` in programs/agentns/src/lib.rs.
VITE_AGENTNS_PROGRAM_ID=3CZ5JZgJdxX2wt8UbmyP9kkHPmiMnHhnbsUAXWj7XdnD